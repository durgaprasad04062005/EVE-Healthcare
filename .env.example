# ---------------------------------------------------------------------------
# EVE Healthcare — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env to version control.
# The .gitignore already excludes it.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=eve
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=eve_healthcare

# --- Database URL (used by the application directly) ---
# For Docker Compose: use 'db' as the hostname (the service name)
DATABASE_URL=postgresql+asyncpg://eve:change_me_strong_password@db:5432/eve_healthcare

# For running locally outside Docker (replace 'db' with 'localhost'):
# DATABASE_URL=postgresql+asyncpg://eve:change_me_strong_password@localhost:5432/eve_healthcare

# --- JWT ---
# Generate a secure secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_real_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
